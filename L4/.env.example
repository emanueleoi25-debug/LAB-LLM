# Copia questo file in .env (Copy-Item .env.example .env) e adatta i valori.
# Indirizzo dell'API compatibile OpenAI di LM Studio (in Docker viene sostituito da compose.yaml).
LMSTUDIO_BASE_URL=http://localhost:1234/v1
# Identificativo del modello come restituito da GET /v1/models.
LMSTUDIO_MODEL=google/gemma-4-e2b
# Livello dei log: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
# Fuso orario usato dallo strumento orologio quando il modello non ne indica uno (nome IANA).
DEFAULT_TIMEZONE=Europe/Rome
# Numero massimo di giri modello→strumenti per ogni domanda (intero >= 1).
MAX_TOOL_STEPS=3
