# Copia questo file in .env (Copy-Item .env.example .env) e adatta i valori.
# Indirizzo dell'API compatibile OpenAI di LM Studio (in Docker viene sostituito da compose.yaml).
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# Identificativo del modello come restituito da GET /v1/models.
LMSTUDIO_MODEL=google/gemma-4-e2b
# Livello dei log: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
# Fuso orario usato dallo strumento orologio quando il modello non ne indica uno (nome IANA).
DEFAULT_TIMEZONE=Europe/Rome
# Numero massimo di giri modello→strumenti per ogni domanda (intero >= 1).
MAX_TOOL_STEPS=3
# Indirizzo del servizio giorni (python -m uvicorn servizio_giorni.app:app --port 8000; in Docker viene sostituito da compose.yaml).
GIORNI_BASE_URL=http://127.0.0.1:8000
# Indirizzo del servizio catalogo (python -m uvicorn servizio_catalogo.app:app --port 8001; in Docker viene sostituito da compose.yaml).
CATALOGO_BASE_URL=http://127.0.0.1:8001
# Archivio SQLite delle note (relativo alla cartella da cui avvii l'app; in Docker viene sostituito da compose.yaml).
NOTE_DB_PATH=dati/note.db
# File con la descrizione dell'ambito dell'assistente, usato dal router per rifiutare le domande fuori ambito (predefinito: ambito.md).
# AMBITO_PATH=ambito.md
